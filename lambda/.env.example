# ============================================================
# Variables de entorno para la Lambda de Alexa-n8n
# Copia este archivo como .env y completa los valores
# ============================================================

# URL base de tu instancia de n8n (sin trailing slash)
# Ejemplos:
#   https://tu-dominio.com/webhook
#   https://n8n.tu-servidor.com/webhook
#   https://abc123.hooks.n8n.cloud/webhook  (si usas n8n cloud)
N8N_WEBHOOK_URL=https://tu-n8n.ejemplo.com/webhook

# (Opcional) Timeout en ms de las llamadas a n8n. Alexa corta a ~8s, por eso el
# default es 7000 (deja margen para responder). Bajalo si tus flujos son rapidos,
# o usa respuestas asincronas si necesitas mas tiempo. No subir por encima de ~7500.
N8N_TIMEOUT_MS=7000

# (Opcional) Token de Voice Monkey para notificaciones n8n -> Alexa
VOICE_MONKEY_TOKEN=tu_token_aqui
VOICE_MONKEY_DEVICE_ID=tu_device_id_aqui
