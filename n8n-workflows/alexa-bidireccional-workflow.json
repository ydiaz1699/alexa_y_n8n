    {
      "parameters": {
        "jsCode": "// Procesar la tarea recibida de Alexa\nconst body = $input.first().json.body;\nconst tarea = body.tarea || 'sin nombre';\nconst userId = body.userId || 'desconocido';\n\n// === AQUI VA TU LOGICA ===\n// Ejemplos:\n// - Disparar otro workflow\n// - Llamar a una API externa\n// - Consultar una base de datos\n// - Enviar un email\n\nconsole.log(`Ejecutando tarea: ${tarea} para usuario: ${userId}`);\n\nreturn [{\n  json: {\n    mensaje: `La tarea ${tarea} se ha ejecutado exitosamente desde n8n.`,\n    status: 'completado',\n    tarea: tarea,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-tarea",
      "name": "Procesar Tarea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 80]
    },
    {
      "parameters": {
        "jsCode": "// Consultar estado de un elemento\nconst body = $input.first().json.body;\nconst elemento = body.elemento || 'sistema';\n\n// === AQUI VA TU LOGICA ===\n// Ejemplo: consultar API, base de datos, servicio externo\n\nreturn [{\n  json: {\n    mensaje: `El estado de ${elemento} es: funcionando correctamente. Ultima verificacion hace 5 minutos.`,\n    status: 'ok',\n    elemento: elemento,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-estado",
      "name": "Consultar Estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Enviar mensaje a destinatario\nconst body = $input.first().json.body;\nconst destinatario = body.destinatario || 'equipo';\nconst contenido = body.contenido || 'sin contenido';\n\n// === AQUI VA TU LOGICA ===\n// Ejemplo: Enviar por Slack, Telegram, Email, WhatsApp\n// Puedes conectar un nodo de Slack/Telegram despues de este\n\nreturn [{\n  json: {\n    mensaje: `Mensaje enviado a ${destinatario}: ${contenido}`,\n    status: 'enviado',\n    destinatario: destinatario,\n    contenido: contenido,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-mensaje",
      "name": "Enviar Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 520]
    },
    {
      "parameters": {
        "jsCode": "// Generar resumen diario\nconst body = $input.first().json.body;\n\n// === AQUI VA TU LOGICA ===\n// Ejemplo:\n// - Consultar calendario (Google Calendar API)\n// - Consultar tareas pendientes (Todoist, Notion)\n// - Consultar emails no leidos\n// - Consultar metricas del negocio\n\nconst ahora = new Date();\nconst resumen = `Resumen del dia ${ahora.toLocaleDateString('es-ES')}: ` +\n  `Tienes 3 reuniones programadas, 5 tareas pendientes, ` +\n  `y 12 emails sin leer. Tu proximo evento es en 2 horas.`;\n\nreturn [{\n  json: {\n    mensaje: resumen,\n    status: 'ok',\n    fecha: ahora.toISOString()\n  }\n}];"
      },
      "id": "code-resumen",
      "name": "Generar Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 740]
    },
    {
      "parameters": {
        "jsCode": "// Control de dispositivo\nconst body = $input.first().json.body;\nconst dispositivo = body.dispositivo || 'dispositivo';\nconst accion = body.accion || 'activar';\n\n// === AQUI VA TU LOGICA ===\n// Ejemplo:\n// - Llamar API de Home Assistant\n// - Controlar dispositivos MQTT\n// - Enviar comando a Tuya/SmartThings\n\nreturn [{\n  json: {\n    mensaje: `${dispositivo} se ha ${accion === 'encender' ? 'encendido' : accion === 'apagar' ? 'apagado' : accion + ' correctamente'}.`,\n    status: 'ok',\n    dispositivo: dispositivo,\n    accion: accion,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-dispositivo",
      "name": "Control Dispositivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 960]
    },
    {
      "parameters": {
        "jsCode": "// Procesar comando libre\nconst body = $input.first().json.body;\nconst comando = body.comando || '';\n\n// === AQUI VA TU LOGICA ===\n// Puedes usar un LLM (OpenAI, etc.) para interpretar el comando\n// y decidir que accion tomar\n\nreturn [{\n  json: {\n    mensaje: `Comando recibido y procesado: ${comando}`,\n    status: 'procesado',\n    comando: comando,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
